[
  {"text": "从前有只乌鸦渴得冒烟，捡到半瓶水，居然还是冰的。", "startMs": 0, "endMs": 5850, "timestampMs": null, "confidence": null},
  {"text": "嘴伸进去差一截，它把头塞了进去，卡住，拔了三分钟。", "startMs": 6000, "endMs": 11850, "timestampMs": null, "confidence": null},
  {"text": "正要认命，它想起祖传秘方：丢石子，水就会乖乖浮上来。", "startMs": 12000, "endMs": 17850, "timestampMs": null, "confidence": null},
  {"text": "第一颗、第二颗、第八百颗，叼到最后它开始给自己记工时。", "startMs": 18000, "endMs": 23850, "timestampMs": null, "confidence": null},
  {"text": "水位真的一毫米一毫米涨上来，乌鸦激动地给自己颁了个奖。", "startMs": 24000, "endMs": 29850, "timestampMs": null, "confidence": null},
  {"text": "低头一喝——空的。光顾着扔，水早被石子溅得一滴不剩。", "startMs": 30000, "endMs": 35850, "timestampMs": null, "confidence": null},
  {"text": "更扎心的是，三米外有个水龙头，正哗哗流着，压根没人管。", "startMs": 36000, "endMs": 41850, "timestampMs": null, "confidence": null},
  {"text": "它愣了五秒，把石子叼回去摆个小圈，自己蹲中间发呆。", "startMs": 42000, "endMs": 47850, "timestampMs": null, "confidence": null},
  {"text": "后来它逢人便讲：水位是抬上来了，可我本来只想喝口水。", "startMs": 48000, "endMs": 53850, "timestampMs": null, "confidence": null},
  {"text": "人总把简单的事练成绝活，再抱着绝活，找不到那口水了。", "startMs": 54000, "endMs": 59850, "timestampMs": null, "confidence": null}
]
